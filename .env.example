# ============================================================
# Nyaya backend configuration
# Copy to .env and adjust. The app runs in Demo Mode without any key.
# ============================================================

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# SQLite (zero setup, great for local dev / demo):
DATABASE_URL=postgresql://neondb_owner:npg_hDmbiL5Jv8TX@ep-broad-king-ax641css-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# PostgreSQL (for deployment — Neon / Supabase / local docker-compose):
# For Neon, use the standard connection string with sslmode=require:
# DATABASE_URL=postgres://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require

# --- LLM provider: auto | groq | huggingface | ollama | demo ---
# "auto" picks the first available: GROQ_API_KEY -> HF_TOKEN -> local Ollama -> demo mode
LLM_PROVIDER=auto

# Groq (recommended free tier — get a key at https://console.groq.com)
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3-32b

# Hugging Face (alternative free tier — token from https://huggingface.co/settings/tokens)
HF_TOKEN=
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings: auto | huggingface | ollama | hash ---
# "auto" -> HF_TOKEN (BGE-M3) -> Ollama (bge-m3) -> deterministic hash embeddings
EMBEDDINGS_PROVIDER=auto
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Vector store: auto | chroma | numpy ---
VECTOR_BACKEND=auto

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Seed admin account (created on first start) ---
ADMIN_EMAIL=admin@nyaya.demo
ADMIN_PASSWORD=NyayaAdmin@2026
